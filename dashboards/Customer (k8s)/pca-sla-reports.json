      "id": 1,
      "options": {
        "content": "# PCA SLA Reports Overview\nExecutive and operational health dashboard for Provider Connectivity Assurance (PCA) SLA reporting. Tracks report generation requests, processing outcomes, report delivery throughput, and storage capacity.",
        "mode": "markdown"
      },
      "pluginVersion": "10.0.0",
      "title": "SLA Reporting Overview",
      "type": "text"
    },
    {
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 3
      },
      "id": 2,
      "panels": [],
      "title": "Executive Summary",
      "type": "row"
    },
    {
      "description": "Overall availability of SLA reporting services. Good: UP (green). Bad: DOWN (red), reporting services are unreachable.",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0": {
                  "color": "red",
                  "index": 0,
                  "text": "DOWN"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "UP"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "unit": "none"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 0,
        "y": 4
      },
      "id": 3,
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "min(up{job=~\"sla.*\"})",
          "instant": true,
          "range": false,
          "legendFormat": "Status",
          "refId": "A"
        }
      ],
      "title": "Reporting System Status",
      "type": "stat"
    },
    {
      "description": "Active report generator workers. Good: 3 workers available (green). Bad: <3 or 0 (yellow/red), degraded capacity.",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 1
              },
              {
                "color": "green",
                "value": 3
              }
            ]
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 4,
        "y": 4
      },
      "id": 4,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(kube_pod_status_phase{namespace=~\"$namespace\", pod=~\".*sla-report-generator.*\", phase=\"Running\"})",
          "instant": true,
          "range": false,
          "legendFormat": "Workers",
          "refId": "A"
        }
      ],
      "title": "Active Generator Workers",
      "type": "stat"
    },
    {
      "description": "Total successfully generated and imported SLA report bundles in the past 24 hours. Good: Matches expected generation schedule. Bad: 0 when reports were expected.",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "unit": "short"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 8,
        "y": 4
      },
      "id": 5,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(increase(sla_reports_api_import_reports_total{result=\"success\"}[24h])) or (0 * sum(sla_reports_api_import_reports_total))",
          "instant": true,
          "range": false,
          "legendFormat": "Reports",
          "refId": "A"
        }
      ],
      "title": "Reports Generated (24h)",
      "type": "stat"
    },
    {
      "description": "Percentage of report imports that completed successfully in the past 24 hours. Good: 100% (green). Bad: <95% (yellow/red), report generation failures.",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "yellow",
                "value": 90
              },
              {
                "color": "green",
                "value": 98
              }
            ]
          },
          "unit": "percent"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 12,
        "y": 4
      },
      "id": 6,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "(((sum(rate(sla_reports_api_import_reports_total{result=\"success\"}[24h])) or vector(0)) / (sum(rate(sla_reports_api_import_reports_total[24h])) > 0)) * 100) or (0 * sum(sla_reports_api_import_reports_total) + 100)",
          "instant": true,
          "range": false,
          "legendFormat": "Success %",
          "refId": "A"
        }
      ],
      "title": "Report Success Rate (24h)",
      "type": "stat"
    },
    {
      "description": "Median (p50) report data consolidation duration. Good: Under 30 seconds. Bad: Over 60 seconds.",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "red",
                "value": 60
              }
            ]
          },
          "unit": "s"
        }
      },
      "gridPos": {
        "h": 4,
        "w": 4,
        "x": 16,
        "y": 4
      },
      "id": 7,
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(sla_reports_api_consolidation_duration_seconds_bucket[1h])))",
          "instant": true,
          "range": false,
          "legendFormat": "Median Duration",
          "refId": "A"
        }
      ],
      "title": "Median Processing Time",
      "type": "stat"
    },
    {
      "description": "Total storage consumed by report datasets and artifacts in MinIO. Good: Steady, gradual storage growth.",
      "datasource": "Prometheus",
