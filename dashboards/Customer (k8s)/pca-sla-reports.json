    {
      "description": "Rate of report generation requests per minute categorized by outcome. Good: Green success line tracks requests. Bad: Spikes of yellow (client errors) or red (service errors).",
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "lineWidth": 2
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Success"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "green",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Client Request Error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "yellow",
                  "mode": "fixed"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Service Error"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "fixedColor": "red",
                  "mode": "fixed"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 9
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"sla_report_trigger\", http_status=~\"2..\"}[5m])) * 60",
          "instant": false,
          "range": true,
          "legendFormat": "Success",
          "refId": "A"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"sla_report_trigger\", http_status=~\"4..\"}[5m])) * 60",
          "instant": false,
          "range": true,
          "legendFormat": "Client Request Error",
          "refId": "B"
        },
        {
          "datasource": "Prometheus",
          "editorMode": "code",
          "expr": "sum(rate(http_requests_total{job=\"sla_report_trigger\", http_status=~\"5..\"}[5m])) * 60",
          "instant": false,
          "range": true,
          "legendFormat": "Service Error",
          "refId": "C"
        }
      ],
      "title": "Report Requests by Outcome (req/min)",
      "type": "timeseries"
    },
