  "panels": [
    {"id": 1, "type": "text", "title": "About this dashboard", "transparent": true, "gridPos": {"h": 4, "w": 24, "x": 0, "y": 0}, "options": {"mode": "markdown", "content": "# Deployment overview\nStart here to understand the operational health of this deployment. The dashboard brings together data collection, Druid availability, Roadrunner connectivity, HDFS health, and node resource capacity. Use it to identify the affected product area, then open its dedicated dashboard for diagnosis. Panels may have no series when an optional service is not deployed; the Prometheus availability alert is the deliberate safeguard for an overall monitoring outage."}},
    {"id": 2, "type": "stat", "title": "Prometheus targets up", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 6, "x": 0, "y": 4}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum(up)", "instant": true, "range": false, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 3, "type": "stat", "title": "Metrics service reachability", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 6, "x": 6, "y": 4}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "fieldConfig": {"defaults": {}, "overrides": []}, "targets": [{"refId": "A", "expr": "metricsService_health_status", "instant": true, "range": false, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 4, "type": "stat", "title": "Druid datasource load", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 6, "x": 12, "y": 4}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["min"], "fields": "", "values": false}}, "fieldConfig": {"defaults": {"unit": "percent"}, "overrides": []}, "targets": [{"refId": "A", "expr": "min(druid_coordinator_datasourceLoadStatus)", "instant": true, "range": false, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 5, "type": "stat", "title": "HDFS dead data nodes", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 6, "w": 6, "x": 18, "y": 4}, "options": {"colorMode": "value", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}}, "fieldConfig": {"defaults": {"min": 0}, "overrides": []}, "targets": [{"refId": "A", "expr": "hadoop_namenode_num_dead_data_nodes", "instant": true, "range": false, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 6, "type": "timeseries", "title": "Roadrunner connectivity", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 9, "w": 12, "x": 0, "y": 10}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}, "fieldConfig": {"defaults": {"min": 0, "max": 1}, "overrides": []}, "targets": [{"refId": "A", "expr": "roadrunner_connection", "legendFormat": "{{hostname}} {{zone}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 7, "type": "timeseries", "title": "Streaming record reads", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 9, "w": 12, "x": 12, "y": 10}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}, "fieldConfig": {"defaults": {"unit": "ops"}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum(rate(spark_executor_recordsRead{job=\"spark_streamingapp\"}[10m]))", "legendFormat": "Records read", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 8, "type": "timeseries", "title": "Node CPU and I/O wait", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 9, "w": 12, "x": 0, "y": 19}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}, "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}, "overrides": []}, "targets": [{"refId": "A", "expr": "sum by(instance) (rate(node_cpu_seconds_total{mode!=\"idle\"}[5m])) / count by(instance) (node_cpu_seconds_total{mode=\"idle\"})", "legendFormat": "CPU {{instance}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "prometheus"}}, {"refId": "B", "expr": "sum by(instance) (rate(node_cpu_seconds_total{mode=\"iowait\"}[5m])) / count by(instance) (node_cpu_seconds_total{mode=\"idle\"})", "legendFormat": "I/O wait {{instance}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "prometheus"}}]},
    {"id": 9, "type": "timeseries", "title": "Node filesystem usage", "datasource": {"type": "prometheus", "uid": "prometheus"}, "gridPos": {"h": 9, "w": 12, "x": 12, "y": 19}, "options": {"legend": {"displayMode": "table", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi"}}, "fieldConfig": {"defaults": {"min": 0, "max": 1, "unit": "percentunit"}, "overrides": []}, "targets": [{"refId": "A", "expr": "avg by(instance, mountpoint) (1 - node_filesystem_avail_bytes{fstype!~\"^(tmpfs|overlay|squashfs)$\",mountpoint!~\"^/var/lib/(docker|containerd)(/.*)?$\"} / node_filesystem_size_bytes{fstype!~\"^(tmpfs|overlay|squashfs)$\",mountpoint!~\"^/var/lib/(docker|containerd)(/.*)?$\"})", "legendFormat": "{{instance}} {{mountpoint}}", "range": true, "editorMode": "code", "datasource": {"type": "prometheus", "uid": "prometheus"}}]}
